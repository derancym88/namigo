# NamiGo X production environment.
#
# Copy to /opt/namigo/.env.production on the VPS and fill in real values from
# the password manager (folder "NamiGo X"). NEVER commit the filled-in file.
#   chmod 600 /opt/namigo/.env.production

# ---- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://amazmaxs.cloud
NODE_ENV=production

# ---- Supabase ------------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://fxiaicfznwmgugypxjlh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role bypasses row-level security - server-side only, never exposed.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Operator secrets ----------------------------------------------------
NAMIGO_OWNER_PIN=
NAMIGO_WEBHOOK_SECRET=
NAMIGO_DATA_DIR=/app-data

# ---- Owner protection ----------------------------------------------------
# IMPORTANT: on a new VPS, LICENSE_SERVER_IP and DEPLOYMENT_IP must both be the
# NEW server IP or the app stays locked. They must match each other.
NAMIGO_OWNER_PROTECTION=enabled
NAMIGO_OWNER_LOCKCODE=
NAMIGO_OWNER_USER_ID=83941736-0886-44de-995b-f1311333b380
NAMIGO_OWNER_COMPANY=AMAZ MAXS ENTERPRISE
NAMIGO_PRODUCT_NAME=NamiGo X
NAMIGO_LICENSE_ID=NGX-AMZMAXS-2026-PROD
NAMIGO_LICENSE_DOMAIN=amazmaxs.cloud
NAMIGO_LICENSE_SERVER_IP=118.107.218.216
NAMIGO_DEPLOYMENT_IP=118.107.218.216
NAMIGO_BUILD_FINGERPRINT=NGX-DEV

# ---- n8n -----------------------------------------------------------------
# N8N_BASE_URL is the in-network address the web app calls.
N8N_BASE_URL=http://namigo-n8n:5678
N8N_HOST=n8n.amazmaxs.cloud
N8N_EDITOR_BASE_URL=https://n8n.amazmaxs.cloud
N8N_WEBHOOK_PUBLIC_URL=https://n8n.amazmaxs.cloud
WEBHOOK_URL=https://n8n.amazmaxs.cloud
# Losing this key makes every stored n8n credential unreadable - back it up.
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
NAMIGO_APP_URL=https://amazmaxs.cloud

# ---- AI providers --------------------------------------------------------
# Paste from password manager item "NamiGo X / AI Provider Keys".
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
FAL_KEY=

# ---- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_DIAMOND=
